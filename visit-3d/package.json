    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
