    {
      "text": "\ud55c \uc0ac\ub78c\uc744 \uc228\uae30\ub824\uace0 \ub2e4\ub978 \uc0ac\ub78c\uc774 \uadf8 \uc0ac\ub78c\uc778 \ucc99\ud55c \uc774\uc57c\uae30\uac00 2\ubc31 \ub144 \uc804 \uc11c\uc6b8\uc5d0\uc11c \uc2e4\uc81c\ub85c \uc788\uc5c8\uc2b5\ub2c8\ub2e4.",
