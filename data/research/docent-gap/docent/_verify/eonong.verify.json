    {
      "text": "\uc704\uc7a5\uc740 \uc624\ub798\uac00\uc9c0 \ubabb\ud588\uace0 \uc724\uc720\uc77c, \uc9c0\ud669, \ucd5c\uc778\uae38 \uc138 \uc0ac\ub78c\uc774 \ubaa8\ub450 \ubd99\uc7a1\ud614\uc2b5\ub2c8\ub2e4.",
