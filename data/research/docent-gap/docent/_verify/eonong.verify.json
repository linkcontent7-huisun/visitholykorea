    {
      "text": "\uc544\ubc84\uc9c0 \uc724\uc7a5\uc740 \uc591\uadfc\uc5d0\uc11c \uccb4\ud3ec\ub418\uc5b4 \uc2e0\uc548 \uc55e\ubc14\ub2e4\uc758 \uba3c \uc12c \uc784\uc790\ub3c4\ub85c, \uc219\ubd80 \uc724\ud604\uc740 \uac15\uc9c4\uc73c\ub85c \uc720\ubc30\ub418\uc5c8\uace0, \ub610 \ub2e4\ub978 \uc219\ubd80 \uc724\uad00\uc218 \uc548\ub4dc\ub808\uc544\uc640 \ub3d9\uc0dd \uc724\uc720\uc624 \uc57c\uace0\ubcf4\ub294 \ucc38\uc218\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
