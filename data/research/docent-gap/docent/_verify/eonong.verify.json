  "sentences": [
    {
      "text": "\uae30\ub984\uc9c4 \uc300\ub85c \uc774\ub984\ub09c \uc774\ucc9c\uc758 \ub108\ub978 \ub4e4 \ud55c\uac00\uc6b4\ub370, \uc5b4\ub18d \uc131\uc9c0\uc5d0 \uc624\uc168\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "'\uc5b4\ub18d'\uc740 \ub9d0 \uadf8\ub300\ub85c \ub18d\uc0ac\uc9d3\uae30\uc5d0 \uc54c\ub9de\uc740 \ub545\uc774\ub77c\ub294 \ub73b\uc73c\ub85c, \ubc15\ud574 \uc2dc\ub300 \uad50\uc6b0\ub4e4\uc774 \uc228\uc5b4\ub4e4\uc5b4 \ub18d\uc0ac\ub97c \uc9d3\uace0 \uc2e0\uc559\uc744 \uc9c0\ud0a4\uba70 \ubf08\ub97c \ubb3b\uc740 \uacf3\uc785\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "\uc774\uacf3\uc5d0\ub294 \ud55c\uad6d \uad50\ud68c\uc5d0 \ucc98\uc74c\uc73c\ub85c \uc0ac\uc81c\ub97c \ubaa8\uc154 \uc624\uae30 \uc704\ud574 \uc911\uad6d\uc744 \uc138 \ubc88\uc774\ub098 \uc624\uac04 \ubc00\uc0ac \uc724\uc720\uc77c \ubc14\uc624\ub85c\uc640 \uadf8 \uc77c\uac00\uc758 \ubb18, \uadf8\ub9ac\uace0 \uadf8\uac00 \ubaa8\uc154 \uc628 \uc8fc\ubb38\ubaa8 \uc2e0\ubd80\ub97c \ube44\ub86f\ud55c \uc5f4\uc77c\uacf1 \ubd84 \ubcf5\uc790\uc758 \ubb18\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "\uc624\ub298\uc740 \ubc00\uc0ac\uc758 \ubd81\uacbd \uae38\uc5d0\uc11c \uc2dc\uc791\ud574 \uc138 \ubc00\uc0ac\uc758 \uc21c\uad50, \uc724\uc528 \uc77c\uac00\uc758 \uc218\ub09c, \uadf8\ub9ac\uace0 \ubb18\uc5ed\uc744 \ucc28\ub840\ub85c \ub458\ub7ec\ubcf4\uaca0\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "\uc724\uc720\uc77c\uc740 \uc591\uadfc \ub300\uac10\ub9c8\uc744 \uad8c\ucca0\uc2e0\uc758 \uc81c\uc790\ub85c, \uad50\ud68c\uac00 \uc138\uc6cc\uc9c4 \uc9c0 \uc11c\ub108 \ud574\uac00 \uc9c0\ub098\uc11c\uc57c \ubcf5\uc74c\uc744 \ubc1b\uc544\ub4e4\uc600\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "\uadf8 \ubb34\ub835 \uc131\uc9c1\uc790 \uc5c6\uc774 \uc2dc\uc791\ud55c \uc870\uc120 \uad50\ud68c\ub294 \ud3c9\uc2e0\ub3c4\uac00 \uc131\uc0ac\ub97c \uc9d1\uc804\ud574\ub3c4 \ub418\ub294\uc9c0, \uc870\uc0c1 \uc81c\uc0ac\uac00 \uc6b0\uc0c1 \uc22d\ubc30\uc778\uc9c0 \uc2a4\uc2a4\ub85c \ub2f5\uc744 \ucc3e\uc9c0 \ubabb\ud574 \ubd81\uacbd\uc5d0 \ubb3c\uc5b4\ubcfc \ubc00\uc0ac\ub97c \ucc3e\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
    },
    {
      "text": "\uc131\uaca9\uc774 \uc628\uc21c\ud558\uace0 \uc785\uc774 \ubb34\uac70\uc6b4 \uc11c\ub978 \uc0b4\uc758 \uc724\uc720\uc77c\uc774 \ucd94\ucc9c\ub418\uc5c8\uace0, \uadf8\ub294 \ucc9c\ud55c \uc0c1\uc778 \uc2e0\ubd84\uc73c\ub85c \ud5d8\ud55c \ubd81\uacbd \uae38\uc744 \uc624\uac00\uc57c \ud558\ub294 \uc784\ubb34\ub97c \uc21c\uc21c\ud788 \ubc1b\uc544\ub4e4\uc600\uc2b5\ub2c8\ub2e4.",
      "verdict": "\uadfc\uac70\uc788\uc74c",
      "evidence": "source copies: cbck.txt and goodnews.txt"
