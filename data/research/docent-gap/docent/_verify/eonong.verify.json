    {
      "text": "\ub450 \ubc88\uc9f8 \uae38\uc5d0\uc11c \uadf8\ub294 \ud6d7\ub0a0 \uc120\uad50\uc0ac\uac00 \uc4f8 \uc131\uc791\uacfc \uc81c\uc758\ub97c \ubc1b\uc544 \uc654\uace0, \uad6c\ubca0\uc544 \uc8fc\uad50\ub294 \ud3ec\ub3c4\ub098\ubb34 \ubb18\ubaa9\uacfc \ud568\uaed8 \ud3ec\ub3c4\uc8fc \ub2f4\uadf8\ub294 \ubc95\uae4c\uc9c0 \uac00\ub974\uccd0 \uc8fc\uc5c8\uc2b5\ub2c8\ub2e4.",
