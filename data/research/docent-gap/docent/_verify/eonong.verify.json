    {
      "text": "\ub3d9\uc815\ub140\ub85c \uc0b4\ub358 \uc0ac\ucd0c \ub204\uc774 \uc724\uc810\ud61c \uc544\uac00\ud0c0\ub294 \uc591\uadfc\uc5d0\uc11c, \uc724\uc6b4\ud61c \ub8e8\uce58\uc544\ub294 \uc11c\uc18c\ubb38 \ubc16\uc5d0\uc11c \ucc38\uc218\ub418\uc5c8\uace0, \uc6b4\ud61c\uc758 \ub0a8\ud3b8 \uc815\uad11\uc218 \ubc14\ub974\ub098\ubc14\ub3c4 \uc774\ub4ec\ud574 \uc21c\uad50\ud588\uc2b5\ub2c8\ub2e4.",
