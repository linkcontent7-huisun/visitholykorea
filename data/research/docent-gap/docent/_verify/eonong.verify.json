    {
      "text": "\ud3ec\ub3c4\uccad\uc740 \uc2e0\ubd80\uc758 \ud589\ubc29\uc744 \uce90\ub0b4\ub824\uace0 \ud639\ub3c5\ud55c \ud615\ubc8c\uc744 \uac00\ud588\uc9c0\ub9cc \uc138 \uc0ac\ub78c\uc740 \ub05d\ub0b4 \uc785\uc744 \uc5f4\uc9c0 \uc54a\uc558\uace0, \ucc38 \ucc9c\uc8fc\ub2d8\uc774\uc2e0 \uc608\uc218 \uadf8\ub9ac\uc2a4\ub3c4\ub97c \ubaa8\ub3c5\ud558\uae30\ubcf4\ub2e4 \ucc9c\ub9cc \ubc88 \uc8fd\uc744 \uac01\uc624\uac00 \ub418\uc5b4 \uc788\ub2e4\uace0 \uc2e0\uc559\uc744 \uace0\ubc31\ud588\uc2b5\ub2c8\ub2e4.",
