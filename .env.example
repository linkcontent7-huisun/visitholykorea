# ---------------------------------------------------------------------------
# Visit Holy Korea — 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. .env.local 은 커밋하지 않는다.
#
# 주의: VITE_ 접두사가 붙은 값은 클라이언트 번들에 그대로 포함된다(= 공개된다).
#       비밀로 지켜야 하는 키는 절대 VITE_ 로 두지 말고 Supabase Edge Function 쪽
#       서버 환경변수로 설정한다(supabase/functions 참고).
# ---------------------------------------------------------------------------

# Supabase — 성지 DB / 인증 / 순례 스탬프
# anon 키는 공개되어도 되는 값이며, 데이터 보호는 RLS 정책으로 한다.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# 한국관광공사 TourAPI (공공데이터포털 발급 서비스키)
# 공모전 규정: 응답을 로컬 DB에 저장하지 않고 매 요청마다 실시간 호출해야 한다.
VITE_TOUR_API_SERVICE_KEY="..."

# 카카오 JavaScript 키 (지도 표시 / 길찾기 링크). 도메인 화이트리스트로 보호되는 공개 키다.
VITE_KAKAO_JS_KEY=""

# 앱이 배포된 공개 URL (공유 카드 OG 태그 등에 사용)
VITE_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 서버 전용 (클라이언트 번들에 포함되지 않음)
# Supabase Edge Function 대시보드 또는 `supabase secrets set` 으로 설정한다.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: AI 순례 가이드 '미카엘'. 예전에는 클라이언트 번들에 심었으나
#                 키가 그대로 노출되어 Edge Function 시크릿으로 옮겼다(ADR 0004).
# GEMINI_API_KEY="..."
#
# KAKAO_REST_API_KEY: 성지·주소록 좌표 지오코딩 배치 작업용 (앱 런타임에는 쓰지 않는다).
# KAKAO_REST_API_KEY="..."
#
# SUPABASE_SERVICE_ROLE_KEY="..."
