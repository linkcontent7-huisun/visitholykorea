# ---------------------------------------------------------------------------
# Visit Holy Korea — 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. .env.local 은 커밋하지 않는다.
#
# 주의: VITE_ 접두사가 붙은 값은 클라이언트 번들에 그대로 포함된다(= 공개된다).
#       비밀로 지켜야 하는 키는 절대 VITE_ 로 두지 말고 Supabase Edge Function 쪽
#       서버 환경변수로 설정한다(supabase/functions 참고).
# ---------------------------------------------------------------------------

# Supabase — 성지 DB / 인증 / 순례 스탬프
# anon 키는 공개되어도 되는 값이며, 데이터 보호는 RLS 정책으로 한다.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# 한국관광공사 TourAPI
# 공모전 규정: 응답을 로컬 DB에 저장하지 않고 매 요청마다 실시간 호출해야 한다.
#
# 브라우저는 공공데이터포털을 직접 부르지 않는다. 같은 출처의 `/api/tour`
# (Vercel 서버리스 `api/tour.ts` · 로컬은 Vite 미들웨어)가 서비스키를 붙여 중계한다.
# 서비스키는 아래 "서버 전용" 절의 TOUR_API_SERVICE_KEY 에 넣는다 — VITE_ 접두사 금지.
# (2026-09-14 실측: 예전 VITE_TOUR_API_SERVICE_KEY 는 배포 번들에 그대로 노출됐다.)
#
# 중계 주소를 다른 곳(예: Supabase Edge Function)으로 바꿀 때만 채운다. 비우면 /api/tour.
VITE_TOUR_PROXY_URL=""

# 카카오 JavaScript 키 (지도 표시 / 길찾기 링크). 도메인 화이트리스트로 보호되는 공개 키다.
VITE_KAKAO_JS_KEY=""

# 앱이 배포된 공개 URL (공유 카드 OG 태그 등에 사용)
VITE_APP_URL="http://localhost:3000"

# 공모전 제출판에서는 관리자·즐겨찾기·순례기록 작성 입구를 숨긴다. Vercel에서만 true로 설정한다.
VITE_SUBMISSION_MODE=""

# ---------------------------------------------------------------------------
# 서버 전용 (클라이언트 번들에 포함되지 않음)
# Supabase Edge Function 대시보드 또는 `supabase secrets set` 으로 설정한다.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY · GEMINI_API_KEY: AI 순례 가이드 '미카엘' (Claude 1순위, Gemini 예비).
#                 예전에는 클라이언트 번들에 심었으나
#                 키가 그대로 노출되어 Edge Function 시크릿으로 옮겼다(ADR 0004).
# ANTHROPIC_API_KEY="..."
# GEMINI_API_KEY="..."
#
# KAKAO_REST_API_KEY: 성지·주소록 좌표 지오코딩 배치 작업용 (앱 런타임에는 쓰지 않는다).
# KAKAO_REST_API_KEY="..."
#
# SUPABASE_SERVICE_ROLE_KEY="..."
#
# TOUR_API_SERVICE_KEY: 공공데이터포털 서비스키(H-03). /api/tour 중계가 서버에서 붙인다.
#   로컬: .env.local 에 넣으면 `npm run dev` 의 /api/tour 와 scripts/ 도구가 읽는다.
#   운영: Vercel Environment Variables 에 넣는다 (VITE_ 접두사 없이).
# TOUR_API_SERVICE_KEY="..."
#
# ALLOWED_ORIGINS: ai-guide·tour-proxy 가 허용할 Origin 목록(쉼표 구분). 기본값은 운영 도메인.
# ALLOWED_ORIGINS="https://visitholykorea-app.vercel.app"
