# ---------------------------------------------------------------------------
# Visit Holy Korea — 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. .env.local 은 커밋하지 않는다.
#
# 주의: VITE_ 접두사가 붙은 값은 클라이언트 번들에 그대로 포함된다(= 공개된다).
#       비밀로 지켜야 하는 키는 절대 VITE_ 로 두지 말고 Supabase Edge Function 쪽
#       서버 환경변수로 설정한다(supabase/functions 참고).
# ---------------------------------------------------------------------------

# Supabase — 성지 DB / 인증 / 순례 스탬프
# anon 키는 공개되어도 되는 값이며, 데이터 보호는 RLS 정책으로 한다.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# 한국관광공사 TourAPI
# 공모전 규정: 응답을 로컬 DB에 저장하지 않고 매 요청마다 실시간 호출해야 한다.
#
# 운영에서는 키를 브라우저에 노출하지 않는다(H-03). tour-proxy Edge Function 을
# 거치고, 서비스키는 서버 시크릿(TOUR_API_SERVICE_KEY)으로 둔다. 아래 프록시 URL 만 공개된다.
VITE_TOUR_PROXY_URL="https://<프로젝트>.supabase.co/functions/v1/tour-proxy"
#
# 로컬 개발에서 프록시 없이 직접 호출하고 싶을 때만 아래 키를 쓴다(이 경로만 클라이언트 키 사용).
VITE_TOUR_API_SERVICE_KEY=""

# 카카오 JavaScript 키 (지도 표시 / 길찾기 링크). 도메인 화이트리스트로 보호되는 공개 키다.
VITE_KAKAO_JS_KEY=""

# 앱이 배포된 공개 URL (공유 카드 OG 태그 등에 사용)
VITE_APP_URL="http://localhost:3000"

# 공모전 제출판에서는 관리자·즐겨찾기·순례기록 작성 입구를 숨긴다. Vercel에서만 true로 설정한다.
VITE_SUBMISSION_MODE=""

# ---------------------------------------------------------------------------
# 서버 전용 (클라이언트 번들에 포함되지 않음)
# Supabase Edge Function 대시보드 또는 `supabase secrets set` 으로 설정한다.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: AI 순례 가이드 '미카엘'. 예전에는 클라이언트 번들에 심었으나
#                 키가 그대로 노출되어 Edge Function 시크릿으로 옮겼다(ADR 0004).
# GEMINI_API_KEY="..."
#
# KAKAO_REST_API_KEY: 성지·주소록 좌표 지오코딩 배치 작업용 (앱 런타임에는 쓰지 않는다).
# KAKAO_REST_API_KEY="..."
#
# SUPABASE_SERVICE_ROLE_KEY="..."
#
# TOUR_API_SERVICE_KEY: 공공데이터포털 서비스키(H-03). tour-proxy 가 서버에서 붙인다.
# TOUR_API_SERVICE_KEY="..."
#
# ALLOWED_ORIGINS: ai-guide·tour-proxy 가 허용할 Origin 목록(쉼표 구분). 기본값은 운영 도메인.
# ALLOWED_ORIGINS="https://visitholykorea-app.vercel.app"
